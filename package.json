{
  "name": "chuyen-thai-nguyen",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Trường THPT Chuyên Thái Nguyên – Họp lớp online: sân trường ảo cơ sở 234A Lương Ngọc Quyến",
  "scripts": {
    "dev": "wrangler dev",
    "static": "node tools/serve.js",
    "db:init": "wrangler d1 execute ctn --local --file=schema.sql",
    "db:init:remote": "wrangler d1 execute ctn --remote --file=schema.sql",
    "deploy": "wrangler deploy",
    "test": "node --test tests/*.test.js"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
